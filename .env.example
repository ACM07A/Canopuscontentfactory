# Application
APP_MODE=demo
NODE_ENV=development
PORT=5173
APP_BASE_URL=http://localhost:5173

# Local persistent data
DATABASE_PATH=./data/canopus-care-demo.db
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
BACKUP_ON_START=1

# Authentication
AUTH_PROVIDER=demo
DEMO_USERNAME=reviewer@canopuscare.com
DEMO_PASSWORD=canopus-demo
DEMO_REVIEWER_PASSWORD=canopus-demo
DEMO_AGENT_EMAIL=agent@canopuscare.demo
DEMO_AGENT_PASSWORD=canopus-demo
DEMO_HOSPITAL_EMAIL=hospital@canopuscare.demo
DEMO_HOSPITAL_PASSWORD=canopus-demo
DEMO_ADMIN_EMAIL=admin@canopuscare.demo
DEMO_ADMIN_PASSWORD=canopus-demo
DEMO_VENDOR_EMAIL=vendor@canopuscare.demo
DEMO_VENDOR_PASSWORD=canopus-demo
SESSION_SECRET=replace-with-a-long-random-value
CONSOLE_TOKEN=replace-with-a-long-random-value
ALLOWED_ORIGINS=http://localhost:5173
ENCRYPTION_KEY=replace-with-a-32-byte-random-value

# Safety
POST_LIVE=0
GROWTH_AUTOPILOT=0
GROWTH_AUTOPILOT_HOURS=6
FACTORY_SAFE_MODE=1
OUTREACH_APPROVER_ID=
OUTREACH_APPROVAL_ID=
ALLOW_REAL_PATIENT_DATA=0
ALLOW_REAL_UPLOADS=0
ALLOW_SCRAPE=0

# Optional text generation
GEMINI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=

# Creative generation (provider calls may consume credits even when a web plan labels a model unlimited)
FREEPIK_API_KEY=
FREEPIK_WEBHOOK_SECRET=
FREEPIK_WEBHOOK_URL=
FREEPIK_IMAGE_MODEL=
FREEPIK_VIDEO_MODEL=
FREEPIK_UNLIMITED_MODELS=
MAGNIFIC_WEB_ENABLED=0
MAGNIFIC_WEB_APP_URL=https://www.magnific.com/app/ai-video-generator
MAGNIFIC_WEB_AUTO_SUBMIT=0
MAGNIFIC_WEB_CONFIRM=0
STEALTH_PROFILE_DIR=

# Optional enrichment
HUNTER_API_KEY=

# Optional delivery
RESEND_API_KEY=
RESEND_FROM=
SENDER_NAME=
SENDER_EMAIL=
SENDER_ADDRESS=
UNSUBSCRIBE_EMAIL=
UNSUBSCRIBE_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=

# Optional social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
IG_ACCESS_TOKEN=
IG_USER_ID=
X_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=

# Optional monitoring
SENTRY_DSN=
